# ============================================================================
# Unknown Unknowns Agent - Environment Variables Example
# ============================================================================
# Copy this file to .env and fill in your actual values

# ========== APPLICATION ==========
APP_NAME=unknown-unknowns-agent
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ========== DATABASE - POSTGRES ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=igniten_core
POSTGRES_USER=igniten_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20

# Connection string (alternative)
# DATABASE_URL=postgresql://user:password@localhost:5432/igniten_core

# ========== DATABASE - NEO4J ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ========== DATABASE - CHROMADB ==========
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
# If using persistent client
CHROMADB_PATH=/path/to/chromadb/storage

# ========== DATABASE - REDIS ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== LLM - GEMINI ==========
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-latest
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ========== EMBEDDINGS ==========
# If using OpenAI embeddings
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# If using Google embeddings
USE_GOOGLE_EMBEDDINGS=true  # true to use Google, false for OpenAI

# ========== API CONFIGURATION ==========
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Set to false in production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# ========== UNKNOWN UNKNOWNS CONFIGURATION ==========
# Default run configuration
DEFAULT_MAX_HYPOTHESES=20
DEFAULT_MAX_INSIGHTS_TO_DELIVER=5
DEFAULT_MIN_INSIGHT_PRIORITY=3
DEFAULT_MIN_IMPACT_USD=10000

# Delivery channels
ENABLE_EMAIL_DELIVERY=false
ENABLE_TEAMS_DELIVERY=false
ENABLE_WHATSAPP_DELIVERY=false
ENABLE_SLACK_DELIVERY=false

# Run schedule
ENABLE_SCHEDULED_RUNS=false
DAILY_RUN_ENABLED=false
DAILY_RUN_TIME=08:00  # UTC time
WEEKLY_RUN_ENABLED=false
WEEKLY_RUN_DAY=monday  # monday, tuesday, etc.
WEEKLY_RUN_TIME=09:00
MONTHLY_RUN_ENABLED=false
MONTHLY_RUN_DAY=1  # Day of month
MONTHLY_RUN_TIME=10:00

# ========== DELIVERY CONFIGURATION ==========
# Email (if enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@igniten.ai

# Microsoft Teams (if enabled)
TEAMS_WEBHOOK_URL=https://your-webhook-url

# WhatsApp (if enabled)
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Slack (if enabled)
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL_ID=your_channel_id

# ========== MONITORING & LOGGING ==========
# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Log file
LOG_FILE_PATH=/var/log/igniten/unknown-unknowns.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

# ========== SECURITY ==========
# API Keys / Tokens
API_SECRET_KEY=your_secret_key_here_change_in_production
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed client IDs (comma-separated)
ALLOWED_CLIENT_IDS=

# ========== FEATURE FLAGS ==========
ENABLE_CHROMADB=true  # Set to false to disable semantic search
ENABLE_PROFILE_ENRICHMENT=false  # FASE 2+
ENABLE_CONVERSATION_LEARNING=false  # FASE 2+
ENABLE_SCHEMA_ANALYSIS=false  # FASE 2+

# ========== PERFORMANCE ==========
# SQL Query timeout (seconds)
SQL_QUERY_TIMEOUT=30

# Hypothesis validation parallelism
MAX_PARALLEL_VALIDATIONS=5

# Cache TTL (seconds)
PROFILE_CACHE_TTL=3600  # 1 hour
INSIGHTS_CACHE_TTL=300  # 5 minutes

# ========== DEVELOPMENT ==========
# Auto-reload on code changes
AUTO_RELOAD=true

# Mock external services (for testing)
MOCK_LLM=false
MOCK_EMAIL=false
MOCK_DATABASES=false

# ========== CLIENT-SPECIFIC OVERRIDES (Example) ==========
# These can override defaults per client
# Format: CLIENT_{CLIENT_ID}_{SETTING}

# Example:
# CLIENT_demo_seguros_001_MAX_HYPOTHESES=30
# CLIENT_demo_seguros_001_MIN_PRIORITY=4

# ============================================================================
# NUEVAS VARIABLES — FASE 1.5: Scheduler + Agent Integration
# ============================================================================

# ========== AGENT CLIENT ==========
# Contenedor del agente SQL en la red igniten_network_global
# Debe ser el nombre del contenedor (ej: agent) no localhost
AGENT_BASE_URL=http://agent:8000

# user_id enviado en cada request al agente (identifica este agente en los logs)
AGENT_USER_ID=unknown-unknowns-agent

# Timeout por request en segundos (el agente puede tardar en analizar SQL)
AGENT_TIMEOUT_SECONDS=120

# Reintentos ante errores temporales (429, 502, 503, timeouts)
AGENT_MAX_RETRIES=3

# Segundos base entre reintentos (backoff exponencial: 5s → 10s → 20s)
AGENT_RETRY_DELAY_SECONDS=5.0

# ========== CRON SCHEDULER ==========
# Timezone del scheduler — Colombia = America/Bogota = UTC-5
CRON_TIMEZONE=America/Bogota

# Día de la semana para el run semanal (monday, tuesday, ..., sunday)
CRON_DAY_OF_WEEK=thursday

# Hora local (según CRON_TIMEZONE) — 11 = 11am Colombia = 16:00 UTC
CRON_HOUR=11

# Minuto del run
CRON_MINUTE=0

# ========== PIPELINE CONFIGURATION ==========
# Hipótesis generadas desde known_pain_points del perfil
MAX_PAIN_POINT_HYPOTHESES=5

# Hipótesis generadas desde strategic_priorities del perfil
MAX_PRIORITY_HYPOTHESES=5

# Total máximo por cliente por run
MAX_HYPOTHESES_PER_CLIENT=10

# Tipo registrado en unknown_unknowns_runs (weekly, daily, ad_hoc)
PIPELINE_RUN_TYPE=weekly
